@startuml client-game
!include style.iuml
title Client 2/2: during the match (package client)

class GameScreen {
    .. the match screen: every frame,\nupdate the game then draw it ..
}

package "Game loop: what to show" #FFF6E8 {
    class ClientGame {
        .. receives snapshots, sends inputs ..
        + update(now, inputs) : WorldSnapshot
    }
    class PredictedPlayer {
        .. moves my brawler at once,\nthen matches the server ..
    }
    class SnapshotBuffer {
        .. smooths the other players ..
    }
    class ClientClock {
        .. estimates the server time ..
    }
}

class InputReader {
    .. keyboard + mouse → PlayerInput,\nor an idle input outside PLAYING ..
}

class InputSequence {
    .. numbers the inputs of a session,\nkept by Main across games ..
    + next()
}

package "3D rendering: how to draw it" #F6EEFB {
    class WorldRenderer3D {
        .. draws map, brawlers, shots,\nfollows the watched brawler ..
        + render(snapshot, arena)
        + screenToWorld(x, y)
    }
    class BrawlerHud {
        .. health, ammo, nicknames ..
    }
    class PlayerRoster <<final>> {
        .. id → nickname and team ..
        + isAlly(id) / myTeam()
    }
    class BulletSprites {
        .. tilted, pulsing bullet images ..
        + hasSprite(type)
        + render(batch, projectile, ally)
    }
    class ArenaModelFactory <<utility>> {
        .. builds the 3D map ..
    }
    class HudAnchor <<record>> {
        .. where a brawler's HUD goes\non the screen ..
    }
    class AvatarFactory {
        .. loads the glTF models once,\ncreates one avatar per brawler ..
        + create(state) : BrawlerAvatar
    }
    interface BrawlerAvatar {
        .. the 3D look of one brawler ..
        + update(state, frameTime)
        + render(batch, environment)
    }
    class AnimatedAvatar {
        .. glTF model, picks its own clips ..
    }
    class CapsuleAvatar {
        .. white capsule: brawler without model ..
    }
}

package "Match HUD: drawn over the 3D view" #FDECEA {
    class MatchHud {
        .. score, countdown, result ..
        + draw(view, watchingText)
    }
    class MatchView <<final>> {
        .. decides the texts (plain Java, tested) ..
        + myScore() / enemyScore()
        + centerText()
        + {static} watchingText(followedId, roster)
    }
    class HitOverlay {
        .. red screen edges ..
        + draw(intensity)
    }
    class HitFlash <<final>> {
        .. decides the red flash when I am hit\n(plain Java, tested) ..
        + update(health, frameTime)
        + reset() / intensity()
    }
}

interface GameSession <<external>>

GameScreen *-down- ClientGame : owns
GameScreen *-down- InputReader : owns
GameScreen *-down- WorldRenderer3D : owns
GameScreen *-down- MatchHud : owns
GameScreen *-down- HitOverlay : owns
GameScreen *-down- HitFlash : owns

ClientGame -left-> GameSession : reads snapshots,\nsends inputs
ClientGame *-down- PredictedPlayer : owns
ClientGame *-down- SnapshotBuffer : owns
ClientGame *-down- ClientClock : owns

InputReader -right-> WorldRenderer3D : where does\nthe mouse aim?
ClientClock -[hidden]right- InputReader
ArenaModelFactory -[hidden]right- MatchHud
InputReader -down-> InputSequence : next number

WorldRenderer3D *-down- BrawlerHud : owns
WorldRenderer3D *-down- AvatarFactory : owns
WorldRenderer3D o-down- "0..*" BrawlerAvatar : one per\nbrawler seen
AvatarFactory .right.> BrawlerAvatar : creates
BrawlerAvatar <|.down. AnimatedAvatar : implements
BrawlerAvatar <|.down. CapsuleAvatar : implements
WorldRenderer3D .down.> HudAnchor : builds
BrawlerHud .down.> HudAnchor : draws at
WorldRenderer3D .down.> ArenaModelFactory : uses
WorldRenderer3D *-down- BulletSprites : owns\n(sphere if no image)
BrawlerHud -down-> PlayerRoster : reads nicknames
MatchHud ..> MatchView : asks what to show

$legend("<b>Every frame</b>: ClientGame gives the world to show, WorldRenderer3D draws it,", "HitOverlay and MatchHud draw over it, InputReader reads what the player does.")
@enduml
