@startuml server
!include style.iuml
title Server (packages server and time)

package "1. Authority: the source of truth" #FDECEA {
    class ServerLauncher {
        .. entry point of make server ..
        + {static} main(args)
    }
    class GameServer {
        .. LOBBY phase, then PLAYING phase.\nOwns the GameWorld (cleared each round).\nEvery tick: apply inputs, move the world,\nupdate the match, send one snapshot per player ..
        + join(channel, name)
        + chooseTeam / chooseMap
        + requestStart(playerId)
        + tick()
    }
    class TickClock {
        .. fixed 30 Hz tick ..
    }
}

class KnockoutMatch <<external>>

package "2. Lobby: the waiting room" #EEF4FF {
    class Lobby <<final>> {
        .. nicknames, teams, leader, map ..
        + join(id, name)
        + canStart()
    }
    class LobbyPlayer <<record>> {
        .. id, name, team ..
    }
    class LobbyException {
        .. a refusal with its reason ..
    }
}

package "3. Translation: protocol ↔ model" #EEFBEF {
    class InputApplier {
        .. PlayerInput → move / attack ..
        + apply(playerId, input)
        + acknowledge(playerId, input)
    }
    class SnapshotBuilder {
        .. world → WorldSnapshot,\nhides enemies in bushes ..
        + build(tick, ..., viewerId)
    }
}

class GameWorld <<external>>
interface ClientChannel <<external>>
class NetworkServer <<external>>

ServerLauncher .down.> GameServer : creates
ServerLauncher .right.> NetworkServer : creates
GameServer *-right- TickClock : owns
GameServer *-down- "1" Lobby : owns
GameServer *-down- "0..1" KnockoutMatch : owns\n(rounds, score)
GameServer *-down- "0..1" InputApplier : owns
GameServer *-down- "0..1" SnapshotBuilder : owns
GameServer -down-> "*" ClientChannel : sends to
Lobby *-down- "0..6" LobbyPlayer : owns
Lobby .down.> LobbyException : throws
InputApplier -down-> GameWorld : changes
SnapshotBuilder -down-> GameWorld : reads
KnockoutMatch .down.> GameWorld : counts players alive

$legend("<b>Source of truth</b>: only the server owns the real GameWorld.", "Clients only send inputs and draw what they receive.")
@enduml
